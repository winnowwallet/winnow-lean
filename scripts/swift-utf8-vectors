#!/bin/bash
# Writes Lean/Vectors/swift-utf8-decoding.json: what Swift's `String(decoding: bytes, as: UTF8.self)` makes
# of well-formed and ill-formed UTF-8, the oracle for `Winnow.Text.decodeUTF8Lossy` (crypto-test's utf8
# section). Needs Xcode's Swift; the program is fed on stdin so the tree holds no .swift file.
#
#   scripts/swift-utf8-vectors            (from the repository root)
set -euo pipefail
cd "$(dirname "$0")/.."
out=Lean/Vectors/swift-utf8-decoding.json
swift_version=$(xcrun swift --version 2>/dev/null | head -1)
SWIFT_VERSION="$swift_version" xcrun swift - > "$out" <<'SWIFT'
import Foundation

func bytes(_ hex: String) -> [UInt8] {
  let h = hex.filter { $0 != " " }
  return stride(from: 0, to: h.count, by: 2).map {
    let a = h.index(h.startIndex, offsetBy: $0)
    return UInt8(h[a..<h.index(a, offsetBy: 2)], radix: 16)!
  }
}

var cases: [(String, [UInt8])] = [
  ("empty", []),
  ("ASCII", Array("hello, world".utf8)),
  ("NUL and DEL", bytes("00 7F")),
  ("U+0080, the first two-byte scalar", bytes("C2 80")),
  ("U+07FF, the last two-byte scalar", bytes("DF BF")),
  ("U+0800, the first three-byte scalar", bytes("E0 A0 80")),
  ("U+D7FF, just below the surrogates", bytes("ED 9F BF")),
  ("U+E000, just above the surrogates", bytes("EE 80 80")),
  ("U+FFFD itself", bytes("EF BF BD")),
  ("U+FFFF", bytes("EF BF BF")),
  ("U+10000, the first four-byte scalar", bytes("F0 90 80 80")),
  ("U+10FFFF, the last scalar", bytes("F4 8F BF BF")),
  ("mixed scripts and an emoji", Array("Grüße, 世界 🌍 €1 𝄞".utf8)),
  ("a user agent", Array("/Satoshi:31.1.0/".utf8)),
  ("lone continuation 80", bytes("80")),
  ("lone continuation BF", bytes("BF")),
  ("three continuations", bytes("80 80 80")),
  ("continuation between ASCII", bytes("61 80 62")),
  ("C0 80, overlong NUL", bytes("C0 80")),
  ("C0 AF, overlong slash", bytes("C0 AF")),
  ("C1 BF, overlong", bytes("C1 BF")),
  ("E0 80 80, overlong three-byte", bytes("E0 80 80")),
  ("E0 9F BF, overlong three-byte", bytes("E0 9F BF")),
  ("F0 80 80 80, overlong four-byte", bytes("F0 80 80 80")),
  ("F0 8F BF BF, overlong four-byte", bytes("F0 8F BF BF")),
  ("ED A0 80, surrogate D800", bytes("ED A0 80")),
  ("ED BF BF, surrogate DFFF", bytes("ED BF BF")),
  ("ED A0 80 ED B0 80, a surrogate pair (CESU-8)", bytes("ED A0 80 ED B0 80")),
  ("F4 90 80 80, U+110000", bytes("F4 90 80 80")),
  ("F4 BF BF BF", bytes("F4 BF BF BF")),
  ("F5 80 80 80", bytes("F5 80 80 80")),
  ("F7 BF BF BF", bytes("F7 BF BF BF")),
  ("F8 88 80 80 80, five-byte form", bytes("F8 88 80 80 80")),
  ("FC 84 80 80 80 80, six-byte form", bytes("FC 84 80 80 80 80")),
  ("FE", bytes("FE")),
  ("FF", bytes("FF")),
  ("FE FF", bytes("FE FF")),
  ("truncated two-byte C3", bytes("C3")),
  ("truncated three-byte E2", bytes("E2")),
  ("truncated three-byte E2 82", bytes("E2 82")),
  ("truncated four-byte F0", bytes("F0")),
  ("truncated four-byte F0 9D", bytes("F0 9D")),
  ("truncated four-byte F0 9D 84", bytes("F0 9D 84")),
  ("truncated F4 8F BF", bytes("F4 8F BF")),
  ("truncated three-byte between ASCII", bytes("61 E2 82 62")),
  ("truncated four-byte at the end of text", bytes("61 62 F0 9F 98")),
  ("truncated three-byte then a whole one", bytes("E2 82 E2 82 AC")),
  ("truncated four-byte then a two-byte", bytes("F0 9D C3 A9")),
  ("two-byte lead then ASCII", bytes("C3 41")),
  ("three-byte lead, continuation, ASCII", bytes("E1 80 41")),
  ("Unicode 3.9's example", bytes("61 F1 80 80 E1 80 C2 62 80 63 80 BF 64")),
  ("invalid bytes inside a user agent", bytes("2F 53 61 74 FF 6F 73 68 69 3A C0 AF 32 37 2F")),
  ("every lead byte alone, C2 to F4", (0xC2...0xF4).map { UInt8($0) }),
]

// seeded runs of bytes, mostly from the high half, so lead/continuation mixes nobody listed are covered
var seed: UInt64 = 0x243F_6A88_85A3_08D3
func next() -> UInt64 {
  seed = seed &* 6_364_136_223_846_793_005 &+ 1_442_695_040_888_963_407
  return seed >> 33
}
for k in 0..<40 {
  let count = Int(next() % 24) + 1
  let run: [UInt8] = (0..<count).map { _ in
    let r = next()
    return r % 4 == 0 ? UInt8(0x20 + r % 0x5F) : UInt8(0x80 + (r >> 2) % 0x80)
  }
  cases.append(("seeded run \(k)", run))
}

func hex(_ b: [UInt8]) -> String { b.map { String(format: "%02x", $0) }.joined() }
func quote(_ s: String) -> String { "\"" + s.replacingOccurrences(of: "\"", with: "\\\"") + "\"" }

let version = ProcessInfo.processInfo.environment["SWIFT_VERSION"] ?? "unknown"
print("{")
print("  \"source\": \(quote("String(decoding: bytes, as: UTF8.self), from scripts/swift-utf8-vectors")),")
print("  \"swift\": \(quote(version)),")
print("  \"vectors\": [")
for (i, (name, b)) in cases.enumerated() {
  let decoded = String(decoding: b, as: UTF8.self)
  let scalars = decoded.unicodeScalars.map { String($0.value) }.joined(separator: ", ")
  let comma = i == cases.count - 1 ? "" : ","
  print("    {\"name\": \(quote(name)), \"bytes\": \"\(hex(b))\", \"scalars\": [\(scalars)]}\(comma)")
}
print("  ]")
print("}")
SWIFT
echo "wrote $out"
