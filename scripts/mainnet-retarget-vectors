#!/usr/bin/env python3
"""Writes Lean/Vectors/mainnet-retargets.json: the headers either side of every mainnet retarget, the oracle
for `HeaderChain.expectedBits` (crypto-test's retarget section). Each row holds the last header of a period and
the first of the next; the period's own first header is the row before's `next` (genesis for the first row).

Reads them from a public Esplora server and trusts it for nothing: each header must hash to the height's block
hash and meet its own proof of work here, and crypto-test checks the links and the work again.

  scripts/mainnet-retarget-vectors            (from the repository root)
"""
import hashlib, json, sys, time, urllib.request
from pathlib import Path

API = "https://blockstream.info/api"
INTERVAL = 2016
OUT = Path(__file__).resolve().parent.parent / "Lean/Vectors/mainnet-retargets.json"


def get(path):
    for attempt in range(6):
        try:
            with urllib.request.urlopen(urllib.request.Request(f"{API}{path}", headers={"User-Agent": "retarget-vectors"}), timeout=30) as r:
                return r.read().decode().strip()
        except Exception:
            if attempt == 5:
                raise
            time.sleep(2 ** attempt)


def checked_header(height):
    block_hash = get(f"/block-height/{height}")
    header = get(f"/block/{block_hash}/header")
    raw = bytes.fromhex(header)
    digest = hashlib.sha256(hashlib.sha256(raw).digest()).digest()[::-1]
    if len(raw) != 80 or digest.hex() != block_hash:
        sys.exit(f"block {height}: the header does not hash to {block_hash}")
    bits = int.from_bytes(raw[72:76], "little")
    if int.from_bytes(digest, "big") > (bits & 0x7fffff) << (8 * ((bits >> 24) - 3)):
        sys.exit(f"block {height}: the header misses its own target")
    time.sleep(0.1)
    return header


def main():
    tip = int(get("/blocks/tip/height"))
    last_boundary = tip // INTERVAL * INTERVAL
    rows = []
    for height in range(INTERVAL, last_boundary + 1, INTERVAL):
        rows.append({"height": height, "last": checked_header(height - 1), "next": checked_header(height)})
        if height % (INTERVAL * 50) == 0:
            print(f"through {height}", flush=True)
    body = ",\n".join("  " + json.dumps(r, separators=(",", ":")) for r in rows)
    OUT.write_text('{"source":"mainnet headers, scripts/mainnet-retarget-vectors",\n"boundaries":[\n' + body + "\n]}\n")
    print(f"{len(rows)} boundaries through {last_boundary}")


main()
