#!/bin/bash
# Writes LeanApp/FoundationVectors.lean: what Foundation and the Swift app (AppModel.swift at 9cca3fc,
# copied below) answer for the explorer URL and manual-peer rules; records-test checks WinnowApp.Pure
# against them. Run from anywhere on a Mac: scripts/foundation-vectors. The Swift is a heredoc because
# the tree holds no .swift file (LeanNative's check-no-swift).
set -euo pipefail
cd "$(dirname "$0")/.."
src=$(mktemp -d)/foundation-vectors.swift
cat > "$src" <<'SWIFT'
import Foundation

// AppModel.isLoopback / explorerBaseURL / esploraTransactionURL / parsePeer, as the Swift app had them
func isLoopback(_ host: String) -> Bool {
    let lowered = host.lowercased()
    return lowered == "localhost" || lowered == "::1" || lowered == "[::1]" || lowered.hasPrefix("127.")
}

func explorerBaseURL(custom: String) -> URL {
    if let url = URL(string: custom), let host = url.host,
       url.scheme?.lowercased() == "https" || (url.scheme?.lowercased() == "http" && isLoopback(host)) {
        return url
    }
    return URL(string: "https://mempool.space/signet")!  // the blockstream preset on signet
}

func parsePeer(_ text: String) -> String? {
    let parts = text.trimmingCharacters(in: .whitespaces).split(separator: ":")
    guard parts.count == 2, !parts[0].isEmpty, let port = UInt16(parts[1]), port > 0 else { return nil }
    return "\(parts[0]):\(port)"  // PeerEndpoint.description
}

// Not here: a host with non-ASCII characters. Foundation applies IDNA (`münchen.de` → `xn--mnchen-3ya.de`);
// the app refuses it and falls back to the preset (records-test checks that separately).
let urls = [
    "https://mempool.space", "https://mempool.space/signet/", "https://blockstream.info/testnet/api",
    "http://localhost:3000", "http://LOCALHOST:3000/", "http://127.0.0.1:8080/api", "HTTP://127.0.0.2",
    "http://[::1]:3000", "http://127.0.0.1.example.com/", "http://example.com", "http://192.168.1.2:3000",
    "https://[2001:db8::1]:8443/api", "https://[fe80::1%en0]/", "https://[fe80::1%25en0]/", "https://[zz::1]/",
    "https://user:pw@example.com/", "https://example.com:443", "https://example.com:99999", "https://example.com:abc",
    "https://", "https:", "", "mempool.space", "ftp://example.com", "https://exa mple.com", "https://ex%41mple.com",
    "https://example.com/a b?c=d e#f", "https://example.com/?%", "https://:/a?%",
    "https://example.com/%zz", "  https://example.com", "https://example.com/esplora?x=1#frag", "1https://x",
]
let peers = [
    "node.example:8333", " node.example:8333 ", "\tnode.example:8333", "node.example:8333\n", "1.2.3.4:18444",
    "node.example:0", "node.example:1", "node.example:65535", "node.example:65536", "node.example:+8333",
    "node.example:-0", "node.example:-1", "node.example:08333", "node.example::8333", ":8333", "node.example",
    "a:b:c", "::1:8333", "[::1]:8333", "node.example:83 33", "node.example:", "",
]
let txid = String(repeating: "ab", count: 32)

func lit(_ s: String) -> String {
    var out = "\""
    for u in s.unicodeScalars {
        switch u {
        case "\"": out += "\\\""
        case "\\": out += "\\\\"
        case "\n": out += "\\n"
        case "\t": out += "\\t"
        default: out += u.value < 0x20 ? String(format: "\\x%02x", u.value) : String(u)
        }
    }
    return out + "\""
}
func opt(_ s: String?) -> String { s.map { "some \(lit($0))" } ?? "none" }

var lines = [
    "/-! Generated by `scripts/foundation-vectors` (Foundation on macOS, the Swift app's AppModel rules);",
    "do not edit. records-test's `foundationURLRules` checks `WinnowApp.Pure` against these. -/",
    "",
    "namespace FoundationVectors",
    "",
    "/-- A custom explorer string on signet: `URL(string:)?.host`, `explorerBaseURL`'s `absoluteString`, and",
    "`esploraTransactionURL` for a txid of `ab` × 32. -/",
    "def urls : List (String × Option String × String × String) := [",
]
for (i, u) in urls.enumerated() {
    let base = explorerBaseURL(custom: u)
    let tx = base.appending(path: "tx").appending(path: txid)
    lines.append("  (\(lit(u)), \(opt(URL(string: u)?.host)), \(lit(base.absoluteString)), \(lit(tx.absoluteString)))" + (i + 1 < urls.count ? "," : "]"))
}
lines += ["", "/-- `AppModel.parsePeer`: the endpoint's description, or none where it throws `invalidPeer`. -/",
          "def peers : List (String × Option String) := ["]
for (i, p) in peers.enumerated() {
    lines.append("  (\(lit(p)), \(opt(parsePeer(p))))" + (i + 1 < peers.count ? "," : "]"))
}
lines += ["", "end FoundationVectors", ""]
try! lines.joined(separator: "\n").write(toFile: "LeanApp/FoundationVectors.lean", atomically: true, encoding: .utf8)
SWIFT
xcrun swift "$src"
