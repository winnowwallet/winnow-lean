#!/usr/bin/env python3
"""Enforces Winnow's first-principles proof boundary and bounds-safety invariants.

1. Zero proof leakage: `WinnowCore`, `Winnow`, and `WinnowApp` never import `WinnowProofs`,
   `Secp.Gate`, `SecpCt.Gate`, or any `*Proofs` / `KeySpecs` module.
2. Zero theorems in runtime code: runtime modules (and pure spec modules `Secp.Curve.Spec`,
   `Secp.Signing`, `Winnow.Spec.*`) contain zero `theorem`, `lemma`, `axiom`, or `sorry` tokens.
3. Strict axiom discipline in proofs: proof modules never use `sorry`, `native_decide`, `bv_decide`,
   or custom `axiom` declarations (complementing `#assert_all_axioms` at `lake build` time).
4. Bounds-safe indexing: modules in `BOUNDS_CLEAN` contain zero `[...]!`, `.get!`, `.set!`,
   `.eraseIdx!`, `.head!`, or `.last!` panicking accessors.
"""
import pathlib
import re
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
LEAN = REPO / "Lean"
LEAN_APP = REPO / "LeanApp"

BOUNDS_CLEAN = """
Secp.Bytes Secp.Sha256 Secp.Der Secp.Curve.Spec Secp.Signing
SecpCt.Word SecpCt.Field SecpCt.Scalar SecpCt.Point SecpCt.Schnorr SecpCt.Ecdsa SecpCt.Keys
""".split()

PROOF_PATTERNS = (
    "WinnowProofs",
    "Secp",
    "SecpCt",
    "Secp.Gate",
    "SecpCt.Gate",
    "SecpCt.KeySpecs",
)


def is_proof_module(mod: str) -> bool:
    if mod in PROOF_PATTERNS:
        return True
    parts = mod.split(".")
    return any(p == "Proofs" or p.endswith("Proofs") for p in parts)


def module_path(mod: str):
    for root in (LEAN, LEAN_APP):
        p = root / (mod.replace(".", "/") + ".lean")
        if p.is_file():
            return p
    return None


def strip_comments_and_strings(text: str) -> str:
    out = []
    i, n = 0, len(text)
    block_depth = 0
    while i < n:
        if block_depth > 0:
            if text[i : i + 2] == "/-":
                block_depth += 1
                i += 2
            elif text[i : i + 2] == "-/":
                block_depth -= 1
                i += 2
            else:
                if text[i] == "\n":
                    out.append("\n")
                i += 1
        else:
            if text[i : i + 2] == "/-":
                block_depth = 1
                i += 2
            elif text[i : i + 2] == "--":
                while i < n and text[i] != "\n":
                    i += 1
            elif text[i] == '"':
                out.append('""')
                i += 1
                while i < n and text[i] != '"':
                    if text[i] == "\\":
                        i += 2
                    else:
                        if text[i] == "\n":
                            out.append("\n")
                        i += 1
                i += 1
            else:
                out.append(text[i])
                i += 1
    return "".join(out)


def imports_of(p: pathlib.Path):
    found = []
    for line in strip_comments_and_strings(p.read_text()).splitlines():
        m = re.match(r"\s*(?:public\s+)?import\s+(.*)", line)
        if m:
            found += [w for w in m.group(1).split() if w != "all"]
    return found


def closure(roots):
    reached = {}
    todo = list(roots)
    while todo:
        mod = todo.pop()
        if mod in reached:
            continue
        p = module_path(mod)
        if p is None:
            continue
        reached[mod] = p
        todo.extend(imports_of(p))
    return reached


def main() -> int:
    errors = []

    runtime_roots = ["WinnowCore", "Winnow"]
    if (LEAN_APP / "WinnowApp.lean").is_file():
        runtime_roots.append("WinnowApp")
    runtime = closure(runtime_roots)
    for spec_mod in ("Secp.Curve.Spec", "Secp.Signing"):
        p = module_path(spec_mod)
        if p is not None:
            runtime[spec_mod] = p

    # 1. Zero proof leakage into runtime closure
    for mod in sorted(runtime):
        if is_proof_module(mod):
            errors.append(f"proof module imported by runtime closure: {mod}")

    # 2. Zero theorems/lemmas/axioms/sorry in runtime & spec modules
    decl_re = re.compile(r"\b(theorem|lemma|axiom|sorry)\b")
    for mod, p in sorted(runtime.items()):
        cleaned = strip_comments_and_strings(p.read_text())
        for lineno, line in enumerate(cleaned.splitlines(), 1):
            m = decl_re.search(line)
            if m:
                errors.append(f"{p.relative_to(REPO)}:{lineno}: forbidden `{m.group(1)}` in runtime/spec module {mod}")

    # 3. Zero sorry / native_decide / bv_decide / axiom in proof modules
    proof_roots = ["Secp", "SecpCt", "WinnowProofs"]
    all_mods = closure(proof_roots)
    banned_proof_re = re.compile(r"\b(sorry|native_decide|bv_decide|axiom)\b")
    for mod, p in sorted(all_mods.items()):
        if mod in runtime:
            continue
        cleaned = strip_comments_and_strings(p.read_text())
        for lineno, line in enumerate(cleaned.splitlines(), 1):
            m = banned_proof_re.search(line)
            if m:
                errors.append(f"{p.relative_to(REPO)}:{lineno}: forbidden `{m.group(1)}` in proof module {mod}")

    # 4. Zero panicking `!`-indexing in bounds-cleaned modules
    bang_re = re.compile(r"(\]!\s*(?!=)|\.get!\b|\.set!\b|\.eraseIdx!\b|\.head!\b|\.last!\b)")
    for mod in BOUNDS_CLEAN:
        p = module_path(mod)
        if p is None:
            errors.append(f"bounds-clean module missing: {mod}")
            continue
        cleaned = strip_comments_and_strings(p.read_text())
        for lineno, line in enumerate(cleaned.splitlines(), 1):
            m = bang_re.search(line)
            if m:
                errors.append(f"{p.relative_to(REPO)}:{lineno}: forbidden panicking accessor `{m.group(1).strip()}` in {mod}")

    for e in errors:
        print(f"check-proofs: {e}", file=sys.stderr)
    if errors:
        return 1

    proof_only = sorted(set(all_mods) - set(runtime))
    print(
        f"check-proofs: {len(runtime)} runtime/spec modules theorem-free, "
        f"{len(proof_only)} proof modules axiom-clean, "
        f"{len(BOUNDS_CLEAN)} modules bounds-clean"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
