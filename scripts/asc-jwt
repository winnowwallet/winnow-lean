#!/usr/bin/env python3
"""Mint an App Store Connect API token (an ES256 JWT, 20 minutes) from an AuthKey .p8 file.

    scripts/asc-jwt <keyPath> <keyId> <issuerId>

The signature is made by `openssl dgst -sha256 -sign` (DER, r and s as ASN.1 integers), which the JWT
wants as the two 32-byte big-endian numbers side by side (RFC 7518 §3.4). Replaces upstream's
asc-jwt.swift: this repository has no Swift."""
import base64, json, subprocess, sys, time


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).rstrip(b"=").decode()


def der_to_raw(der: bytes) -> bytes:
    """ECDSA-Sig-Value ::= SEQUENCE { r INTEGER, s INTEGER } -> r || s, 32 bytes each."""
    def length(i):
        n = der[i]
        if n < 0x80:
            return n, i + 1
        k = n & 0x7F
        return int.from_bytes(der[i + 1:i + 1 + k], "big"), i + 1 + k
    assert der[0] == 0x30, "not a DER sequence"
    _, i = length(1)
    out = b""
    for _ in range(2):
        assert der[i] == 0x02, "not a DER integer"
        n, i = length(i + 1)
        value = der[i:i + n].lstrip(b"\x00")
        assert len(value) <= 32, "not a P-256 signature"
        out += value.rjust(32, b"\x00")
        i += n
    return out


def main():
    if len(sys.argv) != 4:
        sys.exit("usage: asc-jwt <keyPath> <keyId> <issuerId>")
    key_path, key_id, issuer = sys.argv[1:]
    now = int(time.time())
    header = b64url(json.dumps({"alg": "ES256", "kid": key_id, "typ": "JWT"}, separators=(",", ":")).encode())
    payload = b64url(json.dumps({"iss": issuer, "iat": now, "exp": now + 20 * 60, "aud": "appstoreconnect-v1"},
                                separators=(",", ":")).encode())
    signing_input = f"{header}.{payload}".encode()
    der = subprocess.run(["openssl", "dgst", "-sha256", "-sign", key_path], input=signing_input,
                         capture_output=True, check=True).stdout
    print(f"{header}.{payload}.{b64url(der_to_raw(der))}")


if __name__ == "__main__":
    main()
