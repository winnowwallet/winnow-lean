#!/bin/bash
# Inspect the exact distribution package that the next step uploads.
set -euo pipefail
ipa="$1"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
ditto -x -k "$ipa" "$work"
shopt -s nullglob
apps=("$work"/Payload/*.app)
[[ ${#apps[@]} == 1 ]] || { echo 'Expected exactly one exported iPhone app' >&2; exit 1; }
scripts/verify-signed-archive "${apps[0]}" --distribution
shasum -a 256 "$ipa" > "$ipa.verified.sha256"
