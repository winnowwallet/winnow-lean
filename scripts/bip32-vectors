#!/usr/bin/env python3
"""Writes Lean/Vectors/bip32-test-vectors.json: the test vectors of BIP32 itself, the oracle for `HDKey`
(crypto-test's bip32 section). Vectors 1 to 4 give a seed and, for each chain, the extended keys; vector 5 gives
extended keys that must be refused.

  scripts/bip32-vectors            (from the repository root)
"""
import json, re, urllib.request
from pathlib import Path

URL = "https://raw.githubusercontent.com/bitcoin/bips/master/bip-0032.mediawiki"
OUT = Path(__file__).resolve().parent.parent / "Lean/Vectors/bip32-test-vectors.json"

with urllib.request.urlopen(URL, timeout=30) as r:
    text = r.read().decode()

vectors, invalid, current = [], [], None
for line in text.splitlines():
    if m := re.match(r"===Test vector (\d+)===", line):
        current = int(m[1])
        if current < 5:
            vectors.append({"vector": current, "seed": "", "chains": []})
    elif current is None:
        continue
    elif current == 5:
        if m := re.match(r"\* (x(?:pub|prv)\w+) \((.*)\)", line):
            invalid.append({"key": m[1], "why": m[2]})
    elif m := re.match(r"Seed \(hex\): ([0-9a-f]+)", line):
        vectors[-1]["seed"] = m[1]
    elif m := re.match(r"\* \[?Chain (\S+)", line):
        vectors[-1]["chains"].append({"path": m[1].replace("<sub>H</sub>", "'")})
    elif m := re.match(r"\*\* ext (pub|prv): (\w+)", line):
        vectors[-1]["chains"][-1][m[1]] = m[2]

assert len(vectors) == 4 and len(invalid) >= 10
assert all(v["seed"] and all({"pub", "prv"} <= set(c) for c in v["chains"]) for v in vectors)
OUT.write_text(json.dumps({"source": URL, "vectors": vectors, "invalid": invalid}, indent=1) + "\n")
print(f"{sum(len(v['chains']) for v in vectors)} chains, {len(invalid)} invalid keys")
