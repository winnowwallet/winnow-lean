#!/usr/bin/env python3
"""Turn one UI-journeys output into the media the website publishes, with its provenance.

  scripts/prepare-journey-media <journey-out> <media-out> [--run-url URL] [--sha SHA] [--branch NAME]

<journey-out> is a UI-journeys output directory (scripts/ui-journeys' $UI_OUT, CI's $CI_RESULTS/journey). <media-out> must not exist
or be empty; it receives the website's layout:

  screenshots/<name>.png      every checkpoint, validated as PNG
  videos/wallet-journey.mp4   the screen recording, H.264 at most 720 wide and 24 fps (ffmpeg), at most 25 MiB
  journey-provenance.json     version 2: the run, the source, the device, each test's result and seconds,
                              each screenshot's test, size and SHA-256, the video's, and the network

Results come from the result bundle (xcrun xcresulttool) and xcodebuild.log, both required, which must agree;
the script fails when either is missing or any test did not pass. Each screenshot is attributed to the first test that captured it (a
screenshot several tests capture is taken from that test's attachment in the result bundle). Without ffmpeg
the recording is copied when it is already under 25 MiB; otherwise the manifest says why there is no video.
"""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import struct
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
VIDEO = "videos/wallet-journey.mp4"
MANIFEST = "journey-provenance.json"
MAX_BYTES = 25 * 1024 * 1024
PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
NAME = re.compile(r"[a-z0-9][a-z0-9-]*")
LOG_CASE = re.compile(r"^Test Case '-\[(?:[\w.]+\.)?(\w+) (\w+)\]' (passed|failed|skipped) \(([0-9.]+) seconds\)\.",
                      re.M)
LOG_TOTAL = re.compile(r"Executed (\d+) tests?, with (\d+) failures? \(\d+ unexpected\) in ([0-9.]+) ")


class Failure(Exception):
    pass


def digest(path):
    sha = hashlib.sha256()
    with Path(path).open("rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            sha.update(block)
    return sha.hexdigest()


def png_size(path):
    """(width, height) of a PNG, or a Failure: the signature and the IHDR chunk."""
    with Path(path).open("rb") as image:
        head = image.read(24)
    if len(head) < 24 or not head.startswith(PNG_SIGNATURE) or head[12:16] != b"IHDR":
        raise Failure(f"{Path(path).name}: not a PNG image")
    width, height = struct.unpack(">II", head[16:24])
    if width == 0 or height == 0:
        raise Failure(f"{Path(path).name}: PNG has no pixels")
    return width, height


# -- test results ---------------------------------------------------------------------------------------

def xcresulttool(*arguments):
    """Output of `xcrun xcresulttool ...`, or None where there is no xcresulttool (not macOS, no Xcode)."""
    if shutil.which("xcrun") is None:
        return None
    try:
        return subprocess.run(["xcrun", "xcresulttool", *arguments], check=True, text=True,
                              capture_output=True).stdout
    except (subprocess.CalledProcessError, OSError):
        return None


def bundle_results(bundle):
    """The result bundle's test cases [{name, class, result, seconds}] and device, or None without the tool."""
    text = xcresulttool("get", "test-results", "tests", "--path", str(bundle))
    if text is None:
        return None
    return parse_bundle_results(json.loads(text))


def parse_bundle_results(data):
    cases = []

    def walk(node, suite):
        if node.get("nodeType") == "Test Case":
            identifier = node.get("nodeIdentifier", "")
            cls = identifier.split("/")[0] if "/" in identifier else suite
            result = str(node.get("result", "")).lower()
            cases.append({"name": node["name"].rstrip("()"), "class": cls,
                          "result": {"expected failure": "failed"}.get(result, result),
                          "seconds": round(float(node.get("durationInSeconds", 0)), 3)})
            return
        for child in node.get("children", []):
            walk(child, node.get("name") if node.get("nodeType") == "Test Suite" else suite)

    for node in data.get("testNodes", []):
        walk(node, None)
    device = None
    if data.get("devices"):
        first = data["devices"][0]
        os_name = "iOS" if "iOS" in first.get("platform", "iOS") else first.get("platform")
        device = {"name": first.get("modelName"), "os": f"{os_name} {first.get('osVersion')}".strip(),
                  "platform": first.get("platform")}
    return {"tests": cases, "device": device}


def log_results(text):
    cases = [{"name": name, "class": cls, "result": result, "seconds": round(float(seconds), 3)}
             for cls, name, result, seconds in LOG_CASE.findall(text)]
    total = LOG_TOTAL.search(text)
    return {"tests": cases, "succeeded": "** TEST SUCCEEDED **" in text,
            "failed": "** TEST FAILED **" in text,
            "total_seconds": float(total.group(3)) if total else None}


def results(journey):
    """The run's tests from the result bundle and the log, which must agree; a Failure unless all passed."""
    log_path = journey / "xcodebuild.log"
    if not log_path.is_file():
        raise Failure("missing xcodebuild.log")
    log = log_results(log_path.read_text(errors="replace"))
    bundle_path = journey / "journey.xcresult"
    bundle = bundle_results(bundle_path) if bundle_path.is_dir() else None
    if bundle is None:
        raise Failure("no result bundle results (journey.xcresult, read with xcresulttool)")
    tests, device = bundle["tests"], bundle["device"]
    logged = {(t["name"], t["result"]) for t in log["tests"]}
    if logged and logged != {(t["name"], t["result"]) for t in tests}:
        raise Failure("xcodebuild.log and the result bundle disagree about the tests: "
                      f"{sorted(logged)} vs {sorted((t['name'], t['result']) for t in tests)}")
    if not tests:
        raise Failure("no test results in the result bundle or xcodebuild.log")
    if len({t["name"] for t in tests}) != len(tests):
        raise Failure("a test ran more than once; one result per test is expected")
    if bad := [f"{t['name']} {t['result']}" for t in tests if t["result"] != "passed"]:
        raise Failure("not every test passed: " + ", ".join(bad))
    if log["failed"] or not log["succeeded"]:
        raise Failure("xcodebuild.log does not end in ** TEST SUCCEEDED **")
    total = log["total_seconds"] if log["total_seconds"] is not None else sum(t["seconds"] for t in tests)
    return tests, device, round(total, 3)


# -- screenshots ----------------------------------------------------------------------------------------

def bundle_attachments(bundle, into):
    """Export the result bundle's attachments into `into`; the parsed manifest.json, or None without the tool."""
    if xcresulttool("export", "attachments", "--path", str(bundle), "--output-path", str(into)) is None:
        return None
    manifest = Path(into) / "manifest.json"
    return json.loads(manifest.read_text()) if manifest.is_file() else []


def captures(manifest, directory):
    """{screenshot name: [(timestamp, test, file)]} from an attachments manifest, earliest first."""
    found = {}
    for entry in manifest:
        test = entry.get("testIdentifier", "").split("/")[-1].rstrip("()")
        for attachment in entry.get("attachments", []):
            human = attachment.get("suggestedHumanReadableName", "")
            match = re.fullmatch(r"(.+?)_\d+_[0-9A-Fa-f-]{36}\.png", human)
            if not match:
                continue
            found.setdefault(match.group(1), []).append(
                (float(attachment.get("timestamp", 0)), test, Path(directory) / attachment["exportedFileName"]))
    for shots in found.values():
        shots.sort(key=lambda shot: shot[0])
    return found


def screenshots(journey, media, tests, scratch):
    """Copy every checkpoint into media/screenshots; their manifest entries, in name order."""
    folder = journey / "screenshots"
    names = sorted(path.stem for path in folder.glob("*.png")) if folder.is_dir() else []
    if not names:
        raise Failure("no screenshots in " + str(folder))
    if bad := [name for name in names if not NAME.fullmatch(name)]:
        raise Failure("screenshot names must be lowercase letters, digits and hyphens: " + ", ".join(bad))
    bundle = journey / "journey.xcresult"
    exported = bundle_attachments(bundle, scratch) if bundle.is_dir() else None
    if exported is None:
        raise Failure("no result bundle attachments (journey.xcresult, exported with xcresulttool)")
    shots = captures(exported, scratch)
    passed = {t["name"] for t in tests}
    (media / "screenshots").mkdir(parents=True)
    entries = []
    for name in names:
        source = folder / f"{name}.png"
        png_size(source)
        taken = shots.get(name)
        if not taken:
            raise Failure(f"{name}.png is not an attachment of any test in the result bundle")
        on_disk = digest(source)
        if on_disk not in {digest(file) for _, _, file in taken}:
            raise Failure(f"{name}.png matches none of the result bundle's captures of it")
        # the first capture tells the story in order; the file on disk is the last test's
        _, test, source = taken[0]
        if test not in passed:
            raise Failure(f"{name}.png was captured by {test}, which is not among the passing tests")
        png_size(source)
        target = media / "screenshots" / f"{name}.png"
        shutil.copyfile(source, target)
        width, height = png_size(target)
        if target.stat().st_size > MAX_BYTES:
            raise Failure(f"{name}.png exceeds 25 MiB")
        entries.append({"name": name, "test": test, "width": width, "height": height,
                        "bytes": target.stat().st_size, "sha256": digest(target)})
    return entries


# -- video ----------------------------------------------------------------------------------------------

def mp4_boxes(data, start, end):
    while start + 8 <= end:
        size, kind = struct.unpack(">I4s", data[start:start + 8])
        header = 8
        if size == 1:
            size, header = struct.unpack(">Q", data[start + 8:start + 16])[0], 16
        elif size == 0:
            size = end - start
        if size < header or start + size > end:
            return
        yield kind.decode("latin-1"), start + header, start + size
        start += size


def mp4_info(path):
    """Width, height and duration of an MP4 from its moov box (no ffprobe): mvhd, and the video track's tkhd."""
    data = Path(path).read_bytes()
    moov = next(((s, e) for kind, s, e in mp4_boxes(data, 0, len(data)) if kind == "moov"), None)
    if moov is None:
        raise Failure("the recording has no moov box")
    duration = width = height = None
    for kind, s, e in mp4_boxes(data, *moov):
        if kind == "mvhd":
            if data[s] == 1:
                timescale, length = struct.unpack(">IQ", data[s + 20:s + 32])
            else:
                timescale, length = struct.unpack(">II", data[s + 12:s + 20])
            duration = length / timescale if timescale else None
        elif kind == "trak" and width is None:
            for inner, ts, te in mp4_boxes(data, s, e):
                if inner == "tkhd":
                    w, h = struct.unpack(">II", data[te - 8:te])
                    if w and h:
                        width, height = w >> 16, h >> 16
    if not duration or not width:
        raise Failure("the recording's duration or size is unreadable")
    return {"width": width, "height": height, "duration_seconds": round(duration, 3)}


def probe(path):
    if shutil.which("ffprobe"):
        result = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "v:0", "-show_entries",
                                 "format=duration:stream=width,height,codec_name", "-of", "json", str(path)],
                                check=True, text=True, capture_output=True)
        data = json.loads(result.stdout)
        stream = data["streams"][0]
        info = {"width": stream["width"], "height": stream["height"],
                "duration_seconds": round(float(data["format"]["duration"]), 3), "codec": stream.get("codec_name")}
    else:
        info = mp4_info(path)
    if not math.isfinite(info["duration_seconds"]) or info["duration_seconds"] <= 0:
        raise Failure("the recording has no positive duration")
    info.update(bytes=Path(path).stat().st_size, sha256=digest(path))
    return info


def transcode(source, destination, original):
    # leave 1 MiB of the 25 for the container; the size check after is the authority
    bitrate = int(24 * 1024 * 1024 * 8 / original["duration_seconds"])
    if bitrate < 150_000:
        raise Failure(f"a {original['duration_seconds']:.0f} s recording cannot fit 25 MiB at a readable bitrate")
    # simctl can give the last frame the previous sample's long duration; -t keeps the container's timeline
    subprocess.run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-nostdin", "-y", "-fflags", "+igndts",
                    "-i", str(source), "-map", "0:v:0", "-an", "-t", str(original["duration_seconds"]),
                    "-vf", "scale=w='min(720,iw)':h=-2,fps=24", "-c:v", "libx264", "-preset", "medium",
                    "-b:v", str(bitrate), "-maxrate", str(bitrate), "-bufsize", str(bitrate * 2),
                    "-pix_fmt", "yuv420p", "-map_metadata", "-1", "-movflags", "+faststart", str(destination)],
                   check=True)
    video = probe(destination)
    if abs(video["duration_seconds"] - original["duration_seconds"]) > 0.5:
        raise Failure(f"transcoding changed the duration: {original['duration_seconds']} s to "
                      f"{video['duration_seconds']} s")
    return video


def video(journey, media):
    """(video entry, original entry, None) or (None, original or None, why there is no video)."""
    source = journey / "journey.mp4"
    if not source.is_file() or source.stat().st_size == 0:
        return None, None, "the run has no screen recording (journey.mp4)"
    try:
        original = probe(source)
    except (Failure, subprocess.CalledProcessError, KeyError, IndexError, ValueError, struct.error) as error:
        return None, None, f"the screen recording is unreadable: {error}"
    destination = media / VIDEO
    destination.parent.mkdir(parents=True)
    if shutil.which("ffmpeg") and shutil.which("ffprobe"):
        try:
            result = transcode(source, destination, original)
        except (Failure, subprocess.CalledProcessError) as error:
            destination.unlink(missing_ok=True)
            return None, original, f"transcoding failed: {error}"
    elif original["bytes"] <= MAX_BYTES:
        shutil.copyfile(source, destination)
        result = dict(original)
    else:
        return None, original, (f"no ffmpeg to transcode the {original['bytes']:,}-byte recording, "
                                "and it exceeds 25 MiB")
    if result["bytes"] > MAX_BYTES:
        destination.unlink()
        return None, original, f"the browser copy is {result['bytes']:,} bytes, over 25 MiB"
    result["path"] = VIDEO
    return result, original, None


# -- identity -------------------------------------------------------------------------------------------

def git(*arguments):
    try:
        return subprocess.run(["git", "-C", str(ROOT), *arguments], check=True, text=True,
                              capture_output=True).stdout.strip()
    except (subprocess.CalledProcessError, OSError):
        return None


def identity(args):
    # the checkout, not GITHUB_SHA: a pull request's GITHUB_SHA is the merge commit, the lanes check out its head
    sha = args.sha or git("rev-parse", "HEAD") or os.environ.get("GITHUB_SHA")
    if not sha or not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise Failure("--sha must be the tested commit's full SHA")
    run_url = args.run_url
    if not run_url and os.environ.get("GITHUB_RUN_ID"):
        run_url = (f"{os.environ.get('GITHUB_SERVER_URL', 'https://github.com')}/"
                   f"{os.environ['GITHUB_REPOSITORY']}/actions/runs/{os.environ['GITHUB_RUN_ID']}")
        if os.environ.get("GITHUB_RUN_ATTEMPT", "1") != "1":
            run_url += f"/attempts/{os.environ['GITHUB_RUN_ATTEMPT']}"
    if run_url and not re.fullmatch(r"https://\S+/actions/runs/\d+(/attempts/\d+)?", run_url):
        raise Failure("--run-url must be a GitHub Actions run URL")
    branch = (args.branch or os.environ.get("GITHUB_HEAD_REF") or os.environ.get("GITHUB_REF_NAME")
              or git("rev-parse", "--abbrev-ref", "HEAD"))
    return sha, run_url, branch


def device(journey, bundle_device):
    """The simulator: the result bundle's model and OS, with the record of the model ui-tests chose."""
    chosen = {}
    config = journey / "ui.json"
    if config.is_file():
        chosen = json.loads(config.read_text()).get("device") or {}
    result = {"name": chosen.get("name"), "os": chosen.get("os"), "type": chosen.get("type")}
    if bundle_device:
        result["name"] = bundle_device.get("name") or result["name"]
        result["os"] = bundle_device.get("os") or result["os"]
    if chosen.get("name") and bundle_device and bundle_device.get("name") and chosen["name"] != bundle_device["name"]:
        raise Failure(f"ui.json chose {chosen['name']} but the tests ran on {bundle_device['name']}")
    return {key: value for key, value in result.items() if value}


def prepare(journey, media, args):
    journey, media = Path(journey), Path(media)
    if not journey.is_dir():
        raise Failure(f"no journey output at {journey}")
    if media.exists() and any(media.iterdir()):
        raise Failure(f"{media} is not empty")
    media.mkdir(parents=True, exist_ok=True)
    sha, run_url, branch = identity(args)
    tests, bundle_device, total = results(journey)
    with tempfile.TemporaryDirectory() as scratch:
        shots = screenshots(journey, media, tests, Path(scratch))
    recording, original, omitted = video(journey, media)
    classes = sorted({t["class"] for t in tests if t.get("class")})
    evidence = {
        "version": 2,
        "source_sha": sha,
        "run_url": run_url,
        "branch": branch,
        "network": args.network,
        "test": ", ".join(classes) or "UI journeys",
        "result": "passed",
        "test_seconds": total,
        "device": device(journey, bundle_device),
        "tests": [{"name": t["name"], "result": t["result"], "seconds": t["seconds"]} for t in tests],
        "screenshots": shots,
        "video": recording,
        "original_video": original,
        "normalized_at": datetime.now(timezone.utc).replace(microsecond=0).isoformat(),
    }
    if omitted:
        evidence["video_omitted"] = omitted
    (media / MANIFEST).write_text(json.dumps(evidence, indent=2) + "\n")
    return evidence


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("journey", type=Path, help="a UI-journeys output directory (scripts/ui-journeys)")
    parser.add_argument("media", type=Path, help="where the website's media and manifest go")
    parser.add_argument("--run-url", help="the CI run (default: from GITHUB_* in Actions)")
    parser.add_argument("--sha", help="the tested commit (default: the checkout's HEAD)")
    parser.add_argument("--branch", help="the tested branch (default: GITHUB_HEAD_REF or GITHUB_REF_NAME in "
                        "Actions, else the checkout's)")
    parser.add_argument("--network", default="regtest",
                        help="the Bitcoin network the journeys paid on (scripts/ui-fixture: regtest)")
    args = parser.parse_args(argv)
    try:
        evidence = prepare(args.journey, args.media, args)
    except (Failure, OSError, ValueError, KeyError) as error:
        raise SystemExit(f"prepare-journey-media: {error}")
    print(f"{len(evidence['tests'])} tests passed in {evidence['test_seconds']} s; "
          f"{len(evidence['screenshots'])} screenshots; "
          + (f"video {evidence['video']['width']}x{evidence['video']['height']}, {evidence['video']['bytes']:,} bytes"
             if evidence["video"] else f"no video: {evidence['video_omitted']}"))
    print(f"wrote {args.media / MANIFEST}")


if __name__ == "__main__":
    main()
