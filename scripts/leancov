#!/usr/bin/env python3
"""Source-level Lean 4 coverage, McCabe CRAP, and Cognitive Complexity via `leancov`.

Stages out-of-tree instrumented copies of `Lean/Winnow` and `LeanApp/WinnowApp`
under `build/leancov/`, builds only the requested suites, runs them in parallel
(including regtest suites and headless wire-journeys), and prints a strict
source-level report plus JSON and LCOV outputs.

Usage:
  scripts/leancov [options] [suite ...]     stage, build, run suites, and report
  scripts/leancov --fast [options]          run the 13 non-regtest, non-journey suites
  scripts/leancov --report [options] [suite ...]
                                            re-generate report from existing .cov profiles
  scripts/leancov --list                    list available suites

Environment:
  LEANCOV_DIR       Path to the `leancov` repository (default: <repo>/../leancov, else `leancov` on PATH)
  COVERAGE_JOBS     Parallel suite workers (default: 4)
  CI_RESULTS        If set, copies the combined JSON report to $CI_RESULTS/leancov.json
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / 'build' / 'leancov'
PROFILES = OUT / 'profiles'
LOGS = OUT / 'logs'
SITES = OUT / 'sites.json'
STAGE_LEAN = OUT / 'Lean'
STAGE_APP = OUT / 'LeanApp'

SUITES = {
    'multisig-test': ('Lean', []),
    'ledger-test': ('Lean', []),
    'silent-payment-test': ('Lean', []),
    'card-keys-test': ('Lean', []),
    'crypto-test': ('Lean', []),
    'segwit-test': ('Lean', []),
    'secpct-test': ('Lean', ['2000']),
    'fuzz': ('Lean', ['--iterations', '10000', '--seed', '0x77696e6e6f77']),
    'records-test': ('LeanApp', []),
    'multisig-app-test': ('LeanApp', []),
    'ledger-transport-test': ('LeanApp', []),
    'cloud-backup-test': ('LeanApp', []),
    'device-sync-test': ('LeanApp', []),
    'io-test': ('Lean', []),
    'backend-test': ('LeanApp', []),
    'multisig-differential': ('Lean', ['--cases', '9']),
    'card-regtest': ('Lean', []),
    'segwit-regtest': ('Lean', []),
    'journeys': ('LeanApp', []),
}
REGTEST = {'io-test', 'backend-test', 'multisig-differential', 'card-regtest', 'segwit-regtest'}
FAST_SUITES = [s for s in SUITES if s not in REGTEST and s != 'journeys']

LEAN_EXCLUDES = [
    'Proofs/', 'Spec/', 'Test.lean', 'Regtest.lean', 'Differential.lean',
    'Fuzz.lean', 'CensusCheck.lean', 'WinnowProofs.lean', 'TestKit.lean',
    'Secp.lean', 'SecpCt.lean',
]
APP_EXCLUDES = [
    'Project.lean', 'Test.lean', 'Journeys.lean', 'IosProject.lean',
    'FoundationVectors.lean', 'AppTestNames.lean', 'WinnowApp/Backend.lean',
]


def run(cmd, **kw):
    return subprocess.run(cmd, check=True, text=True, **kw)


def _find_leancov_repo(exe_path):
    for parent in exe_path.resolve().parents:
        if (parent / 'lakefile.lean').exists():
            return parent
    return None


def resolve_leancov(arg_dir=None):
    explicit = arg_dir or os.environ.get('LEANCOV_DIR')
    if explicit:
        leancov_dir = Path(explicit).resolve()
        if not (leancov_dir / 'lakefile.lean').exists():
            sys.exit(f'leancov: repository not found at {leancov_dir} (set LEANCOV_DIR or pass --leancov-dir)')
        exe = leancov_dir / '.lake' / 'build' / 'bin' / 'leancov'
        if not exe.exists():
            print(f'Building leancov in {leancov_dir}...', flush=True)
            run(['lake', 'build', 'leancov'], cwd=leancov_dir)
        return leancov_dir, exe

    sibling = (ROOT.parent / 'leancov').resolve()
    if (sibling / 'lakefile.lean').exists():
        exe = sibling / '.lake' / 'build' / 'bin' / 'leancov'
        if not exe.exists():
            print(f'Building leancov in {sibling}...', flush=True)
            run(['lake', 'build', 'leancov'], cwd=sibling)
        return sibling, exe

    which = shutil.which('leancov')
    if which:
        exe = Path(which).resolve()
        if exe != Path(__file__).resolve():
            return _find_leancov_repo(exe), exe

    sys.exit(
        f'leancov: not found at {sibling} or on PATH '
        '(set LEANCOV_DIR, pass --leancov-dir, or install leancov on PATH)'
    )


def stage_packages(leancov_dir, leancov_exe):
    if leancov_dir is None:
        sys.exit('leancov: staging requires the leancov package directory (set LEANCOV_DIR or pass --leancov-dir)')
    OUT.mkdir(parents=True, exist_ok=True)
    if SITES.exists():
        SITES.unlink()

    cmd_lean = [
        str(leancov_exe), 'stage',
        '--pkg', str(ROOT / 'Lean'),
        '--out', str(STAGE_LEAN),
        '--leancov', str(leancov_dir),
        '--src-dir', 'Winnow',
        '--prefix', 'Lean',
        '--sites', str(SITES),
    ]
    for pat in LEAN_EXCLUDES:
        cmd_lean += ['--exclude', pat]
    run(cmd_lean)

    cmd_app = [
        str(leancov_exe), 'stage',
        '--pkg', str(ROOT / 'LeanApp'),
        '--out', str(STAGE_APP),
        '--leancov', str(leancov_dir),
        '--src-dir', 'WinnowApp',
        '--prefix', 'LeanApp',
        '--dep', f'winnow={STAGE_LEAN}',
        '--sites', str(SITES),
        '--append-sites',
    ]
    for pat in APP_EXCLUDES:
        cmd_app += ['--exclude', pat]
    run(cmd_app)


def build_suites(suites):
    lean_targets = sorted({s for s in suites if SUITES[s][0] == 'Lean'})
    app_targets = sorted({s for s in suites if SUITES[s][0] == 'LeanApp'})
    if lean_targets:
        print(f'Building Lean targets: {", ".join(lean_targets)}', flush=True)
        run(['lake', 'build', *lean_targets], cwd=STAGE_LEAN)
    if app_targets:
        print(f'Building LeanApp targets: {", ".join(app_targets)}', flush=True)
        run(['lake', 'build', *app_targets], cwd=STAGE_APP)


def run_suite(leancov_exe, suite, base_env):
    pkg, args = SUITES[suite]
    stage_pkg = STAGE_LEAN if pkg == 'Lean' else STAGE_APP
    src_pkg = ROOT / pkg
    exe = stage_pkg / '.lake' / 'build' / 'bin' / suite
    profile = PROFILES / f'{suite}.cov'
    log = LOGS / f'{suite}.log'
    PROFILES.mkdir(parents=True, exist_ok=True)
    LOGS.mkdir(parents=True, exist_ok=True)
    profile.unlink(missing_ok=True)

    # Never leave peers.json beside general test binaries (it changes CensusCatalog behavior).
    (stage_pkg / '.lake' / 'build' / 'bin' / 'peers.json').unlink(missing_ok=True)

    with open(log, 'w') as lf:
        if suite == 'journeys':
            # Run journeys from an isolated directory so peers.json sits only beside journeys.
            jdir = OUT / 'journeys-run'
            shutil.rmtree(jdir, ignore_errors=True)
            jdir.mkdir(parents=True)
            jexe = jdir / 'journeys'
            shutil.copy2(exe, jexe)
            shutil.copy2(ROOT / 'build' / 'census' / 'peers.json', jdir / 'peers.json')

            evidence = OUT / 'wire-journeys'
            shutil.rmtree(evidence, ignore_errors=True)
            evidence.mkdir(parents=True)
            fixture = ROOT / 'scripts' / 'ui-fixture'
            fenv = dict(base_env, APP_DIR=str(ROOT / 'LeanApp'), APP_ROOT='WinnowApp', SCHEME='WinnowLean')
            try:
                code = subprocess.run(
                    [str(fixture), 'start', str(evidence)],
                    stdout=lf, stderr=subprocess.STDOUT, env=fenv,
                ).returncode
                test_env = evidence / 'test-env'
                if code == 0 and test_env.exists():
                    for line in test_env.read_text().splitlines():
                        if '=' in line:
                            k, v = line.split('=', 1)
                            fenv[k] = v
                if code == 0:
                    jenv = dict(fenv, LEANNATIVE_DRIVER='wire')
                    code = subprocess.run(
                        [str(leancov_exe), 'run', '--sites', str(SITES), '--profile', str(profile), '--',
                         str(jexe), str(evidence)],
                        cwd=src_pkg, stdout=lf, stderr=subprocess.STDOUT, env=jenv,
                    ).returncode
            finally:
                subprocess.run(
                    [str(fixture), 'stop', str(evidence), ''],
                    stdout=lf, stderr=subprocess.STDOUT, env=fenv,
                )
        else:
            code = subprocess.run(
                [str(leancov_exe), 'run', '--sites', str(SITES), '--profile', str(profile), '--',
                 str(exe), *args],
                cwd=src_pkg, stdout=lf, stderr=subprocess.STDOUT, env=base_env,
            ).returncode

    mark = '✓' if code == 0 else '✗'
    print(f'  {mark} {suite} (exit {code})', flush=True)
    return suite, code


def select_suites(suites, fast=False):
    selected = list(FAST_SUITES) if (fast and not suites) else (list(suites) if suites else list(SUITES))
    unknown = [s for s in selected if s not in SUITES]
    if unknown:
        sys.exit(f'leancov: unknown suite(s): {", ".join(unknown)} (use --list)')
    return selected


def report_selection(args):
    if not args.report:
        return [], ''
    if args.suites:
        return list(args.suites), '-'.join(args.suites)
    if args.fast:
        return list(FAST_SUITES), 'fast'
    return [], ''


def parse_args(argv=None):
    p = argparse.ArgumentParser(description='Source-level Lean 4 coverage & CRAP via leancov')
    p.add_argument('suites', nargs='*', help='Suite names to run (or report with --report); default all')
    p.add_argument('--fast', action='store_true', help='Run the 13 fast suites (skip regtest and journeys)')
    p.add_argument('--report', action='store_true', help='Skip build/run and report from existing .cov profiles')
    p.add_argument('--no-build', action='store_true', help='Skip staging and lake build; run staged binaries as-is')
    p.add_argument('--clean', action='store_true', help='Delete build/leancov before staging')
    p.add_argument('--list', action='store_true', help='List available suite names and exit')
    p.add_argument('--jobs', type=int, default=int(os.environ.get('COVERAGE_JOBS', '4')),
                   help='Parallel suite workers (default: COVERAGE_JOBS or 4)')
    p.add_argument('--leancov-dir', default=None,
                   help='Path to leancov repo (default: $LEANCOV_DIR, ../leancov, or leancov on PATH)')
    p.add_argument('--sort', choices=['cog', 'crap', 'cc', 'uncov', 'cov'], default='cog',
                   help='Sort order for top functions (default: cog)')
    p.add_argument('--top', type=int, default=20, help='Number of top functions to display (default: 20)')
    p.add_argument('--file', dest='files', action='append', default=[],
                   help='Filter report to files matching substring (repeatable)')
    p.add_argument('--decl', dest='decls', action='append', default=[],
                   help='Filter report to declarations matching substring (repeatable)')
    p.add_argument('--exclude-kind', dest='exclude_kinds', action='append', default=[],
                   help='Exclude branch kind from report (repeatable)')
    p.add_argument('--exclude-instances', action='store_true',
                   help='Exclude typeclass instance declarations from report')
    p.add_argument('--html', nargs='?', const='default', default=None,
                   help='Generate standalone HTML report (default: build/leancov/html)')
    p.add_argument('--markdown', nargs='?', const='default', default=None,
                   help='Write Markdown coverage summary (default: build/leancov/report.md)')
    p.add_argument('--no-files', action='store_true', help='Omit per-file table')
    p.add_argument('--no-kinds', action='store_true', help='Omit per-branch-kind table')
    p.add_argument('--missed', action='store_true', help='Print missed line numbers under top functions')
    p.add_argument('--min-cov', type=float, default=None, help='Fail if branch coverage is below PCT')
    p.add_argument('--max-crap', type=float, default=None, help='Fail if max McCabe CRAP exceeds VAL')
    p.add_argument('--max-cog-crap', type=float, default=None, help='Fail if max Cognitive CRAP exceeds VAL')
    return p.parse_args(argv)


def main():
    args = parse_args()
    if args.list:
        for s in SUITES:
            kind = 'journeys' if s == 'journeys' else ('regtest' if s in REGTEST else 'fast')
            print(f'{s:24s} {SUITES[s][0]:8s} {kind}')
        return

    selected = select_suites(args.suites, fast=args.fast)

    leancov_dir, leancov_exe = resolve_leancov(args.leancov_dir)

    if args.clean and not args.report:
        shutil.rmtree(OUT, ignore_errors=True)

    status_file = OUT / 'status.json'
    status = json.loads(status_file.read_text()) if (status_file.exists() and (args.suites or args.fast or args.report)) else {}

    codes = {}
    if not args.report:
        if not args.no_build:
            stage_packages(leancov_dir, leancov_exe)
            build_suites(selected)
        elif not SITES.exists():
            sys.exit(f'leancov: {SITES} not found; run without --no-build first')

        if not args.suites and not args.fast:
            shutil.rmtree(PROFILES, ignore_errors=True)
            shutil.rmtree(LOGS, ignore_errors=True)

        env = dict(os.environ)
        if REGTEST & set(selected):
            bitcoin = run([str(ROOT / 'scripts' / 'install-bitcoin')], capture_output=True).stdout.strip()
            env.update(WINNOW_BITCOIND=f'{bitcoin}/bitcoind', WINNOW_BITCOIN_CLI=f'{bitcoin}/bitcoin-cli')
        if 'journeys' in selected and not (ROOT / 'build' / 'census' / 'peers.json').exists():
            run([str(ROOT / 'scripts' / 'import-census')])

        print(f'Running {len(selected)} suite(s) with {args.jobs} worker(s)...', flush=True)
        with ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
            codes = dict(pool.map(lambda s: run_suite(leancov_exe, s, env), selected))

        status.update({s: ('passed' if c == 0 else f'exit {c}') for s, c in codes.items()})
        OUT.mkdir(parents=True, exist_ok=True)
        status_file.write_text(json.dumps(dict(sorted(status.items())), indent=2) + '\n')

    if not SITES.exists():
        sys.exit(f'leancov: {SITES} not found; run suites first')

    report_subset, tag = report_selection(args)
    if report_subset:
        cov_files = [PROFILES / f'{s}.cov' for s in report_subset]
        missing = [str(p) for p in cov_files if not p.exists()]
        if missing:
            sys.exit(f'leancov: missing profile(s): {", ".join(missing)}')
        dest_json = OUT / f'coverage-{tag}.json'
        dest_lcov = OUT / f'lcov-{tag}.info'
        profile_args = [a for p in cov_files for a in ('--profile', str(p))]
    else:
        cov_files = sorted(PROFILES.glob('*.cov'))
        if not cov_files:
            sys.exit(f'leancov: no .cov profiles found in {PROFILES}')
        dest_json = OUT / 'coverage.json'
        dest_lcov = OUT / 'lcov.info'
        profile_args = ['--profile-dir', str(PROFILES)]

    report_cmd = [
        str(leancov_exe), 'report',
        '--sites', str(SITES),
        *profile_args,
        '--json', str(dest_json),
        '--lcov', str(dest_lcov),
        '--sort', args.sort,
        '--top', str(args.top),
    ]
    if not args.no_files:
        report_cmd.append('--files')
    if not args.no_kinds:
        report_cmd.append('--kinds')
    if args.missed:
        report_cmd.append('--missed')
    for fpat in args.files:
        report_cmd += ['--file', fpat]
    for dpat in args.decls:
        report_cmd += ['--decl', dpat]
    for ek in args.exclude_kinds:
        report_cmd += ['--exclude-kind', ek]
    if args.exclude_instances:
        report_cmd.append('--exclude-instances')
    extra_artifacts = []
    if args.html is not None:
        dest_html = (OUT / 'html') if args.html == 'default' else Path(args.html)
        report_cmd += ['--html', str(dest_html), '--src-root', str(ROOT)]
        extra_artifacts.append(str(dest_html / 'index.html'))
    if args.markdown is not None:
        dest_md = (OUT / 'report.md') if args.markdown == 'default' else Path(args.markdown)
        report_cmd += ['--markdown', str(dest_md)]
        extra_artifacts.append(str(dest_md))
    if args.min_cov is not None:
        report_cmd += ['--min-cov', str(args.min_cov)]
    if args.max_crap is not None:
        report_cmd += ['--max-crap', str(args.max_crap)]
    if args.max_cog_crap is not None:
        report_cmd += ['--max-cog-crap', str(args.max_cog_crap)]

    rep = subprocess.run(report_cmd)
    if not report_subset and os.environ.get('CI_RESULTS') and dest_json.exists():
        ci_dir = Path(os.environ['CI_RESULTS'])
        ci_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(dest_json, ci_dir / 'leancov.json')

    all_artifacts = [str(dest_json), str(dest_lcov), *extra_artifacts]
    print(f'\nArtifacts: {" | ".join(all_artifacts)}', flush=True)
    failed_suites = [s for s, c in codes.items() if c != 0]
    if failed_suites:
        print(f'FAILED suites: {", ".join(failed_suites)} (see {LOGS})', file=sys.stderr)
        sys.exit(1)
    sys.exit(rep.returncode)


if __name__ == '__main__':
    main()
